# Copy the generated file only as a private backup. Use node deploy/ops.mjs init to create it.
# Each setting is one raw KEY=value line (no quoting or shell expansion).
OPENBOT_ADMIN_EMAIL=
OPENBOT_SIGNIN_DOMAINS=
OPENBOT_AUTH_SECRET=
OPENBOT_ENCRYPTION_KEY=
OPENBOT_REGISTRATION_KEY=

# Google OAuth web client, authorized redirect http://localhost:3001/api/auth/callback/google.
OPENBOT_GOOGLE_CLIENT_ID=
OPENBOT_GOOGLE_CLIENT_SECRET=

# Managed CopilotKit Intelligence defaults. Set a real project key, or change both
# URLs and use a compatible self-hosted Intelligence deployment and license.
INTELLIGENCE_API_URL=https://api.intelligence.copilotkit.ai
INTELLIGENCE_GATEWAY_WS_URL=wss://realtime.intelligence.copilotkit.ai
CPK_INTELLIGENCE_API_KEY=
COPILOTKIT_LICENSE_TOKEN=
# For built-in OpenBot model flows if needed. The Warden executor uses fixed operations.
OPENBOT_OPENAI_API_KEY=

# Set after initial sign-in. The API key's owner must own the private Bot.
OPENBOT_API_KEY=
OPENBOT_ORGANIZATION_ID=
OPENBOT_BOT_ID=

# Generated independently. Keep the approver token with the human approver.
OPS_MCP_TOKEN=
OPS_AGENT_TOKEN=
OPS_BRIDGE_TOKEN=
OPS_APPROVER_TOKEN=
OPS_LAB_TOKEN=
